PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
# Gmail: ative verificação em 2 etapas e crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="Sistema de Moeda Estudantil <seu-email@gmail.com>"
FRONTEND_URL=http://localhost:5173
# URL pública da API (imagens de QR nos e-mails). Em produção use o domínio real do backend.
API_PUBLIC_URL=http://localhost:4000
